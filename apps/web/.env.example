# Copy to .env.local and fill in values
# See root .env.example for full reference

DATABASE_URL="postgresql://isjain@localhost:5432/google_review_app"
OPENAI_API_KEY="sk-..."
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
RESEND_API_KEY="re_..."
ALERT_FROM_EMAIL="alerts@yourdomain.com"
NEXT_PUBLIC_FORM_URL="http://localhost:3001"

# Dev-only: when "true", exposes GET /api/dev/token to read back the logged-in
# user's captured Google OAuth tokens (for copying a refresh token during testing).
# Leave unset/false in real production. TODO(pre-public): remove this flag + route.
DEV_TOKEN_CAPTURE="false"
