# Copy to .env.local and fill in values

DATABASE_URL="postgresql://isjain@localhost:5432/google_review_app"
OPENAI_API_KEY="sk-..."

# Private-feedback email alerts (ADR 0018) — sent to the business Owner when a
# customer leaves private (rating <4) feedback. Without these the send no-ops.
RESEND_API_KEY="re_..."
ALERT_FROM_EMAIL="Jugnoo <alerts@jugnoo.olbaid.de>"
# Used to build the "View in dashboard" CTA link in the email.
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3000"
