// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses Business[]
}

enum Role {
  OWNER
  ADMIN
}

// ── Businesses ───────────────────────────────────────────────

model Business {
  id                  String    @id @default(cuid())
  name                String
  businessType        String    @default("restaurant") // vertical → picks the Taxonomy Template at onboarding
  googleLocationId    String    @unique // e.g. "accounts/123/locations/456"
  googlePlaceId       String?
  googleMapsReviewUrl String?
  accessToken         String?
  refreshToken        String?
  tokenExpiresAt      DateTime?
  ownerId             String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner             User                @relation(fields: [ownerId], references: [id])
  reviews           Review[]
  anonymousFeedback AnonymousFeedback[]
  alertConfigs      AlertConfig[]
  qrCodes           QrCode[]
  printOrders       PrintOrder[]
  formConfig        FormConfig?
}

// ── Reviews ──────────────────────────────────────────────────

model Review {
  id             String    @id @default(cuid())
  businessId     String
  googleReviewId String    @unique
  authorName     String
  authorPhoto    String?
  rating         Int // 1–5
  text           String?
  tags                String[]  @default([]) // AI-extracted themes (populated by analysis job)
  negativeTags        String[]  @default([]) // Subset of tags where sentiment = negative
  unmappedInsights    String[]  @default([]) // LLM-identified insights outside the taxonomy
  publishedAt         DateTime
  isReplied           Boolean   @default(false)
  replyText           String?
  repliedAt           DateTime?
  analyzedAt          DateTime? // Set when the review has been processed by the batch analyzer
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

// ── Anonymous Feedback ───────────────────────────────────────

model AnonymousFeedback {
  id              String   @id @default(cuid())
  businessId      String
  rating          Int // 1–5
  text            String?  // Free-text typed by customer (optional)
  generatedReview String?  // LLM-generated review text shown to customer
  tags                String[]  @default([]) // Chips selected by customer
  negativeTags        String[]  @default([]) // Subset of tags where sentiment = negative
  unmappedInsights    String[]  @default([]) // LLM-identified insights outside the taxonomy
  source              String    @default("private") // "private" | "google_redirect"
  status              String    @default("unread")
  photos              String[]  // Stored as URLs
  analyzedAt          DateTime? // Set when the feedback has been processed by the batch analyzer
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

// ── Alert Configuration ──────────────────────────────────────

model AlertConfig {
  id         String    @id @default(cuid())
  businessId String
  email      String
  alertType  AlertType
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, alertType])
}

enum AlertType {
  NEW_REVIEW
  RATING_DROP
}

// ── Form Config ─────────────────────────────────────────────

model FormConfig {
  id             String   @id @default(cuid())
  businessId     String   @unique
  brandColor     String   @default("#2563EB")
  logoUrl        String?
  // Per-language greeting, e.g. { "en": "Thanks for visiting!", "de": "…" }.
  // Resolved to defaultLanguage on the form (base-language fallback when blank).
  welcomeMessage Json     @default("{}")
  // The single language the form renders in + the analyzer's canonical-label language.
  defaultLanguage String  @default("en")
  // Languages whose labels are auto-filled + editable in settings (ISO 639-1, lowercase).
  supportedLanguages String[] @default(["en"])
  updatedAt      DateTime @updatedAt

  business   Business           @relation(fields: [businessId], references: [id])
  categories FeedbackCategory[]
}

// A grouping ("zone") of tags shown on the form + fed to the analyzer. Modeled
// symmetrically to Tag: carries per-language labels and an optional canonical key.
model FeedbackCategory {
  id           String   @id @default(cuid())
  formConfigId String
  // Per-language display labels, e.g. { "en": "Front of House", "de": "Service" }.
  labels       Json     @default("{}")
  // Optional shared key inherited from a template, for future cross-business comparison.
  canonicalKey String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  formConfig FormConfig @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  tags       Tag[]
}

// The stable, identity-bearing unit of the taxonomy. `id` is the identity stored
// on Review.tags / AnonymousFeedback.tags — never the display wording. Display
// lives in `labels`; storage/analytics/AI all operate on `id`.
model Tag {
  id           String    @id @default(cuid())
  categoryId   String
  polarity     Polarity
  // Per-language display labels, e.g. { "en": "Long Wait", "de": "Lange Wartezeit" }.
  labels       Json      @default("{}")
  order        Int       @default(0)
  // Inactive = hidden from the form, still resolvable for historical analytics.
  active       Boolean   @default(true)
  source       TagSource @default(template)
  // The language the owner originally authored it in — the fallback-chain anchor.
  authoredLanguage String @default("en")
  // Optional shared key inherited from a template; custom/promoted tags have none.
  canonicalKey String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category FeedbackCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

enum Polarity {
  positive
  negative
}

enum TagSource {
  template
  custom
  insight
}

// ── Waitlist ─────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  message   String?
  source    String   @default("landing")
  createdAt DateTime @default(now())
}

// ── QR Codes ─────────────────────────────────────────────────

model QrCode {
  id         String   @id @default(cuid())
  businessId String
  code       String   @unique @default(cuid())
  label      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

// ── Print Orders ─────────────────────────────────────────────
// A business's request for Jugnoo to produce + ship physical review cards.
// Pilot: free, fulfilled manually from the Lantern admin app (no shipping
// address captured — operator contacts the business directly).

// A Print Order is a CART of one or more PrintOrderItem line items submitted
// together (ADR 0012). A business may have only one active (status="pending")
// order at a time. The flat quantity/hasNfc/language/theme columns below are
// LEGACY — kept only for rows created before ADR 0012; new orders leave them at
// their defaults and carry the real variants on PrintOrderItem.
model PrintOrder {
  id          String    @id @default(cuid())
  businessId  String
  quantity    Int       @default(0) // LEGACY (pre-ADR-0012) — variants now live on items
  hasNfc      Boolean   @default(false) // LEGACY (pre-ADR-0012)
  language    String    @default("en") // LEGACY (pre-ADR-0012)
  theme       String    @default("green-black") // RETIRED (ADR 0011) — kept for old rows; no longer written
  logoUrl     String? // Snapshot of the logo used on the whole order at order time
  status      String    @default("pending") // "pending" | "fulfilled"
  createdAt   DateTime  @default(now())
  fulfilledAt DateTime?

  business Business         @relation(fields: [businessId], references: [id])
  items    PrintOrderItem[]
}

// One line of a Print Order cart: a single (hasNfc × language) Card Template
// variant plus a quantity, capped at 6 per item (ADR 0012).
model PrintOrderItem {
  id           String  @id @default(cuid())
  printOrderId String
  hasNfc       Boolean @default(false) // QR-only (false) vs QR + NFC (true)
  language     String  @default("en") // SVG template language: "en" | "de" (ADR 0011)
  quantity     Int // 1–6 physical cards of this variant

  printOrder PrintOrder @relation(fields: [printOrderId], references: [id], onDelete: Cascade)

  @@index([printOrderId])
}

// ── App Feedback ─────────────────────────────────────────────

model AppFeedback {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  rating     Int      // 1–5 emoji rating for the Jugnoo app experience
  businessId String?  // context only, not a foreign key relation
}
