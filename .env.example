# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://isjain@localhost:5432/google_review_app"

# ── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ── Google OAuth (Business Profile API) ───────────────
# Create at https://console.cloud.google.com
# Enable: Google Business Profile API
# Scopes: openid, email, profile, https://www.googleapis.com/auth/business.manage
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ── NextAuth (dashboard app) ────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (Resend) ─────────────────────────────────────
# Get key at https://resend.com
RESEND_API_KEY="re_..."
ALERT_FROM_EMAIL="alerts@yourdomain.com"

# ── App URLs ───────────────────────────────────────────
NEXT_PUBLIC_FORM_URL="http://localhost:3001"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3000"

# ── Dashboard data source ──────────────────────────────
# When signed in with a Google account that manages a Business Profile, the dashboard
# auto-links the first location and fetches REAL reviews/data live from the Business API.
# When logged out (or no managed location is found), it falls back to this seeded business
# for local testing.
DEV_BUSINESS_ID="cmpabfbxs001np8qjvk5l6s14"
