# Copy to .env.local and fill in values
# See root .env.example for full reference

DATABASE_URL="postgresql://isjain@localhost:5432/google_review_app"
OPENAI_API_KEY="sk-..."
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
RESEND_API_KEY="re_..."
ALERT_FROM_EMAIL="alerts@yourdomain.com"
NEXT_PUBLIC_FORM_URL="http://localhost:3001"
# Feature flags (set to "true" to enable)
NEXT_PUBLIC_CARDS_STUDIO="false"   # full card studio (template/theme/NFC/print)
NEXT_PUBLIC_ANALYTICS="false"      # review-analytics dashboard (sentiment, zones, insights)
SHOW_SAMPLE_DATA="false"           # SEED-IMPORT (ADR-0020): "sample data" banner while pilots run on imported Google reviews
